# ============================================
# Progree Cloud Computing Internship
# .gitignore
# ============================================

# ----------------------------
# Environment variables / secrets
# ----------------------------
.env
.env.*
!.env.example

# ----------------------------
# AWS credentials / sensitive files
# ----------------------------
.aws/
credentials
*.pem
*.key
*.p12
*.pfx

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ----------------------------
# Node.js
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----------------------------
# Terraform
# ----------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
.terraform.lock.hcl

# Keep example Terraform variable files
!*.tfvars.example

# ----------------------------
# Build / temporary files
# ----------------------------
dist/
build/
tmp/
temp/
*.tmp
*.log

# ----------------------------
# IDE / Editor
# ----------------------------
.vscode/
.idea/
*.swp
*.swo

# ----------------------------
# Operating system files
# ----------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------
# Archives / deployment packages
# ----------------------------
*.zip
*.tar
*.tar.gz
